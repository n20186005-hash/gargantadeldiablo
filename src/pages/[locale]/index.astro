/** 把 .jpg 路径换成对应的 .webp（图片压缩脚本会生成同名 WebP） */
function webp(src: string): string {
  return src.replace(/\.jpe?g$/i, '.webp');
}

function weekdayShort(dateStr: string): string {
  const [y, m, d] = dateStr.split('-').map(Number);
  const dt = new Date(y, (m || 1) - 1, d || 1);
  return dt.toLocaleDateString(INTL_LOCALE[locale], { weekday: 'short' });
}

function formatUpdated(iso: string): string {
  const dt = new Date(iso);
  if (Number.isNaN(dt.getTime())) return '';
  return dt.toLocaleString(INTL_LOCALE[locale], { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
}

const todayWeather = weather?.daily?.[0];
/** 面向游客的「可执行建议」：穿搭 / 游玩 / 随身 / 风险，由天气条件动态生成 */
const advice = weather
  ? buildWeatherAdvice(
      {
        code: weather.code,
        temp: weather.temp,
        feelsLike: weather.feelsLike,
        humidity: weather.humidity,
        wind: weather.wind,
        uv: weather.uv,
        isDay: weather.isDay,
        tMax: todayWeather?.tMax ?? weather.temp,
        tMin: todayWeather?.tMin ?? weather.temp,
        precipProb: todayWeather?.precipProb ?? 0,
        precipSum: todayWeather?.precipSum ?? 0,
        uvMax: todayWeather?.uvMax ?? weather.uv,
      },
      locale
    )
  : null;
const adviceHtml = advice ? renderAdviceHtml(advice) : '';
