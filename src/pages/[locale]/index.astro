                        <div class="weather-day-rain">{d.precipProb}%</div>
                        <div class="weather-day-temps"><span class="tmax">{d.tMax}°</span><span class="tmin">{d.tMin}°</span></div>
                      </div>
                    ))}
                  </div>
                </div>
              </>
