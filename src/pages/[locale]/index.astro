---

<BaseLayout locale={locale} title={seo.title} description={seo.description}>
  <!-- 导航 -->
  <nav class="site-nav" id="site-nav">
    <div style="display:flex;align-items:center;gap:1.5rem;">
      <span style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;color:#fff;">Garganta del Diablo<span style="font-family:var(--font-body);font-size:0.8rem;font-weight:500;opacity:0.75;margin-left:0.5rem;">· {ENTITY.city}, {ENTITY.province}</span></span>
    </div>
    <div style="display:flex;align-items:center;gap:2rem;">
      <div class="nav-links">
        <a href="#entity">{ent.navEntity}</a>
        <a href="#compare">{extra.compareNav}</a>
        <a href="#history">{t.nav.history}</a>
        <a href="#architecture">{t.nav.architecture}</a>
        <a href="#monuments">{t.nav.monuments}</a>
        <a href="#eco">{t.nav.eco}</a>
        <a href="#visiting">{t.nav.visiting}</a>
        <a href="#weather">{navExtra.weather}</a>
        <a href="#facilities">{navExtra.facilities}</a>
        <a href="#legends">{navExtra.legends}</a>
        <a href="#transportation">{t.nav.transportation}</a>
        <a href="#gallery">{t.nav.gallery}</a>
        <a href="#reviews">{t.nav.reviews}</a>
        <a href="#faq">{t.nav.faq}</a>
        <a href="#location">{t.nav.location}</a>
        <a href="#sources">{ent.navSources}</a>
        <a href="#sitemap">{t.siteMap.title}</a>
        <a href="#itinerary">{t.itinerary.title}</a>
      </div>
      <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle theme" type="button">
        <span class="theme-icon-sun">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </span>
        <span class="theme-icon-moon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </span>
      </button>
      <div class="lang-switcher">
        {
          (['es', 'zh', 'en', 'it'] as Locale[]).map((l) => (
            <button class={l === locale ? 'lang-btn active' : 'lang-btn'} data-locale={l} type="button">
              {LANG_LABELS[l]}
            </button>
          ))
        }
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <picture>
        <source type="image/webp" srcset={webp('/gallery/garganta-del-diablo-1.jpg')} />
        <img class="hero-bg-img" src="/gallery/garganta-del-diablo-1.jpg" alt={heroAlt(locale)} loading="eager" fetchpriority="high" />
      </picture>
    </div>
    <div class="hero-texture"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-tagline">{t.hero.tagline}</p>
      <h1 class="hero-title">{t.hero.title}<span class="hero-title-city">{ent.heroCitySuffix}</span></h1>
      <p class="hero-subtitle">{t.hero.subtitle}</p>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;justify-content:center;margin-bottom:1rem;">
        {
          t.hero.tags.map((tag: string) => (
            <span style="background:rgba(255,255,255,0.2);padding:0.25rem 0.75rem;border-radius:100px;font-size:0.85rem;font-weight:600;color:#fff;backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,0.3);">
              {tag}
            </span>
          ))
        }
      </div>
      <div class="hero-description">
        <p>📍 {t.hero.description.address}</p>
        <p>🧭 {ENTITY.plusCode}</p>
        <p>📞 {t.hero.description.phone}</p>
        <p>🏛️ {t.hero.description.category}</p>
      </div>
      <a href="#transportation" class="hero-cta">
        {t.hero.ctaLlegar}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17L17 7M17 7H7M17 7V17"></path>
        </svg>
      </a>
      <div class="hero-cta-group">
        <a href="#visiting" class="hero-cta-secondary">{t.visiting.title}</a>
        <a href={MAPS_URL} target="_blank" rel="noopener noreferrer" class="hero-cta-secondary">{t.location.openMaps}</a>
      </div>
      <div class="hero-facts">
        {
          verified.facts.map((f) => (
            <span class="hero-fact"><span class="hero-fact-icon">{f.icon}</span>{f.label}: {f.value}</span>
          ))
        }
      </div>
    </div>
    <a href={MAPS_URL} target="_blank" rel="noopener noreferrer" style="text-decoration:none;color:inherit;">
      <div class="hero-meta">
        <div class="hero-rating">4.7</div>
        <div class="hero-stars">★ ★ ★ ★ ★</div>
        <div class="hero-reviews">{ENTITY.reviewCountLabel} {t.rating.reviews} · {t.rating.source}</div>
      </div>
    </a>
  </section>

  <!-- Entity Breadcrumb (geographic hierarchy) -->
  <nav class="entity-breadcrumb" aria-label={ent.breadcrumbAria}>
    <ol>
      <li><a href={`/${locale}`}>{ent.breadcrumbHome}</a></li>
      <li><span>{ENTITY.fullName}</span></li>
      <li><span>{ENTITY.city}</span></li>
      <li><span>{ENTITY.province}</span></li>
      <li><span>{ENTITY.country}</span></li>
    </ol>
  </nav>

  <!-- Entity Overview (semantic entity binding) -->
  <section id="entity" class="section entity-section">
    <div class="reveal">
      <p class="section-label">A</p>
      <p class="about-text entity-lead" set:html={renderText(ent.intro)}></p>
    </div>
    <!-- 站内锚文本内链：锚文本携带地域词，强化实体关联 -->
    <nav class="reveal quick-links" aria-label={QUICK_LINKS_TITLE[locale]}>
      <span class="quick-links-label">{QUICK_LINKS_TITLE[locale]}</span>
      <div class="quick-links-list">
        {QUICK_LINKS[locale].map((link) => (
          <a class="quick-link" href={link.href}>{link.label}</a>
        ))}
      </div>
    </nav>
    <div class="reveal entity-block">
      <h2 class="entity-h2">{ent.aboutTitle}</h2>
      <p class="about-text" set:html={renderText(ent.aboutText)}></p>
    </div>
    <div class="reveal entity-block">
      <h2 class="entity-h2">{ent.locationTitle}</h2>
      <p class="about-text" set:html={renderText(ent.locationText)}></p>
    </div>
    <div class="reveal entity-block">
      <h2 class="entity-h2">{ent.landmarksTitle}</h2>
      <p class="about-text" set:html={renderText(ent.landmarksText)}></p>
    </div>
    <div class="reveal entity-block">
      <h2 class="entity-h2">{ent.historyTitle}</h2>
      <p class="about-text" set:html={renderText(ent.historyText)}></p>
    </div>
  </section>

  <!-- Name Disambiguation (short, homepage only) -->
  <section id="compare" class="section" style="background:rgba(0,0,0,0.02);">
    <div class="reveal">
      <p class="section-label">00</p>
      <h2 class="section-title">{disambiguation.h2}</h2>
      <div class="section-divider"></div>
      <p class="about-text" style="white-space:pre-line;margin-bottom:1.5rem;" set:html={renderText(disambiguation.text)}></p>
    </div>
    <div class="reveal">
      <a href={disambiguation.href} class="compare-full-link">{disambiguation.cta} →</a>
    </div>
  </section>

  <!-- Verified info (E-E-A-T, source-attributed) -->
  <section id="verified" class="section verified-section">
    <div class="reveal">
      <p class="section-label">00b</p>
      <h2 class="section-title">{verified.title}</h2>
      <div class="section-divider"></div>
      <p class="about-text" style="margin-bottom:1.5rem;">{verified.intro}</p>
    </div>
    <div class="reveal">
      <div class="verified-grid">
        {
          verified.facts.map((f) => (
            <div class="verified-card">
              <div class="verified-icon">{f.icon}</div>
              <div>
                <div class="verified-label">{f.label}</div>
                <div class="verified-value">{f.value}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="reveal">
      <p class="about-text" style="white-space:pre-line;margin-bottom:1.25rem;" set:html={renderText(verified.community)}></p>
      <p class="verified-source">
        {verified.sourceLabel}:{' '}
        <a href={verified.sourceUrl} target="_blank" rel="noopener noreferrer">{verified.sourceName}</a>
        <span class="verified-updated"> · {verified.updated}</span>
      </p>
    </div>
  </section>

  <!-- Detailed guides (internal links to intent subpages) -->
  <section id="guias" class="section" style="background:var(--color-cream);">
    <div class="reveal">
      <p class="section-label">00c</p>
      <h2 class="section-title">{guideLinks.title}</h2>
      <div class="section-divider"></div>
    </div>
    <div class="reveal">
      <div class="guides-grid">
        {
          guideLinks.items.map((g) => (
            <a class="guide-card" href={g.href}>
              <div class="guide-icon">{g.icon}</div>
              <div>
                <div class="guide-name">{g.name}</div>
                <div class="guide-desc">{g.desc}</div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- History -->
  <section id="history" class="section">
    <div class="reveal">
      <p class="section-label">01</p>
      <h2 class="section-title">{t.history.title}</h2>
      <div class="section-divider"></div>
    </div>
    <div class="reveal">
      <p class="about-text" style="white-space:pre-line;margin-bottom:3rem;" set:html={renderText(t.history.intro)}></p>
    </div>
    <div class="reveal">
      <h3 style="font-family:var(--font-display);font-size:1.25rem;font-weight:650;color:var(--color-deep);margin:0 0 0.75rem;">{t.myths.title}</h3>
      <p style="color:var(--color-earth-soft);line-height:1.7;margin:0 0 1.25rem;" set:html={renderText(t.myths.intro)}></p>
      <div class="faq-list">
        {
          t.myths.items.map((item: any) => (
            <div class="faq-item">
              <button class="faq-question" data-faq type="button">
                <span style="color:var(--color-deep);font-weight:600;">{item.title}</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="faq-icon">
                  <path d="M6 9l6 6 6-6"></path>
                </svg>
              </button>
              <div class="faq-answer">
                {String(item.content)
                  .split('\n\n')
                  .map((paragraph: string) => (
                    <p style="white-space:pre-line;" set:html={renderText(paragraph)}></p>
                  ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="reveal">
      <div style="padding:2rem;background:var(--color-cream);border-radius:12px;border:1px solid rgba(0,0,0,0.05);position:relative;overflow:hidden;">
        <div style="position:absolute;top:-10px;right:-10px;opacity:0.05;transform:rotate(15deg);">
          <svg width="120" height="120" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path>
          </svg>
        </div>
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem;">
          <h3 style="font-family:var(--font-display);font-size:1.2rem;font-weight:600;color:var(--color-deep);margin:0;">{t.curiosities.title}</h3>
        </div>
        <p style="font-size:1rem;color:var(--color-earth-soft);line-height:1.6;margin:0;position:relative;z-index:1;white-space:pre-line;" set:html={renderText(t.curiosities.content)}></p>
      </div>
    </div>
    <div class="reveal">
      <div class="history-timeline-panel">
        <h3 class="history-timeline-title">{extra.timeline.title}</h3>
        <p class="history-timeline-intro" set:html={renderText(extra.timeline.intro)}></p>
        <div class="history-timeline-grid">
          {
