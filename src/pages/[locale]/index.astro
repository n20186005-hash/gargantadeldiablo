                      <div class="weather-now-sub">{wl.feelsLike} {weather.feelsLike}°C</div>
                    </div>
                  </div>
                  <div class="weather-metrics">
                    <div class="weather-metric"><span class="weather-metric-label">{wl.humidity}</span><span class="weather-metric-value">{weather.humidity}%</span></div>
                    <div class="weather-metric"><span class="weather-metric-label">{wl.wind}</span><span class="weather-metric-value">{weather.wind} km/h</span></div>
