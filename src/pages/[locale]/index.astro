---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { translations, type Locale } from '../../i18n/translations';
import { getSeo } from '../../lib/seo';
import galleryImagesData from '../../gallery-data.json';

export function getStaticPaths() {
  return (['es', 'en', 'zh', 'it'] as Locale[]).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = translations[locale];
const seo = getSeo(locale);
const MAPS_URL = 'https://maps.app.goo.gl/5omkpMV3k3cC52ku5';
const GALLERY_PLAN = [
  { key: 'gorge', from: 0, to: 6 },
  { key: 'waterfall', from: 7, to: 11 },
  { key: 'rock', from: 12, to: 16 },
  { key: 'panorama', from: 17, to: 21 },
];
function categoryForIndex(i: number): string {
  const plan = GALLERY_PLAN.find((p) => i >= p.from && i <= p.to);
  return plan ? plan.key : 'gorge';
}
const galleryImages = (galleryImagesData as string[]).map((src, i) => ({ src, category: categoryForIndex(i) }));
const ALL_LABELS: Record<Locale, string> = { zh: '全部', en: 'All', es: 'Todas', it: 'Tutte' };

const MARKER_POS: Record<string, { top: string; left: string }> = {
  entrada: { top: '74%', left: '16%' },
  iglesia: { top: '56%', left: '38%' },
  monumento: { top: '28%', left: '54%' },
  corrales: { top: '70%', left: '70%' },
  necrópolis: { top: '44%', left: '84%' },
};

const LANG_LABELS: Record<Locale, string> = { zh: '中文', en: 'EN', es: 'ES', it: 'IT' };

const GOOGLE_REVIEWS = [
  { name: 'Carlos M.', avatar: 'CM', rating: 5, date: '2025-06-12', text: 'Impresionante cañón natural. La caminata hasta la cascada es inolvidable y el sonido del agua retumbando entre las paredes de roca te deja sin palabras. Imperdible si estás en Tilcara.' },
  { name: 'Laura B.', avatar: 'LB', rating: 5, date: '2025-05-03', text: 'Un lugar mágico donde la naturaleza muestra su fuerza. El Paso Estrecho es sobrecogedor y la cascada, especialmente después de las lluvias, es espectacular. La energía del lugar es única.' },
  { name: 'Marco R.', avatar: 'MR', rating: 5, date: '2025-04-18', text: 'Canyon naturale magnifico nel cuore della Quebrada. Il sentiero è ben segnalato, la cascata è mozzafiato e il passaggio stretto regala emozioni uniche. Consigliatissimo!' },
  { name: '张明', avatar: '张', rating: 5, date: '2025-03-22', text: '大自然的鬼斧神工！狭缝穿行那段太震撼了，两侧岩壁几乎碰到一起。瀑布虽然不是最大的，但在峡谷中的回声特别有力量。徒步难度适中，强烈推荐！' },
  { name: 'Emily T.', avatar: 'ET', rating: 5, date: '2025-02-09', text: 'Absolutely breathtaking natural wonder. The slot passage is thrilling and the waterfall echoing through the gorge is mesmerizing. Wear good shoes — the terrain is rocky but worth every step.' },
  { name: 'Diego F.', avatar: 'DF', rating: 4, date: '2024-11-15', text: 'Una joya natural cerca de Tilcara. El sendero es accesible, las vistas panorámicas son increíbles y la experiencia de caminar dentro del cañón es única. Llevar agua y protección solar.' },
];

function renderText(text: string): string {
  if (!text) return '';
  return text
    .split(/(\*\*.*?\*\*)/g)
    .map((part) => {
      if (part.startsWith('**') && part.endsWith('**')) return `<strong>${part.slice(2, -2)}</strong>`;
      return part;
    })
    .join('');
}

const transportSections = [
  {
    title: t.transportation.airport.title,
    content: t.transportation.airport.content,
    options: t.transportation.airport.options,
  },
  ...(t.transportation.publicTransport
    ? [{ title: t.transportation.publicTransport.title, content: t.transportation.publicTransport.content, options: t.transportation.publicTransport.options }]
    : []),
  {
    title: t.transportation.city.title,
    content: t.transportation.city.content,
    steps: t.transportation.city.steps,
  },
];

