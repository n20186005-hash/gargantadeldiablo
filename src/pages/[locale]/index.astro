                    <div class="weather-metric"><span class="weather-metric-label">{wl.uvIndex}</span><span class="weather-metric-value" style={`color:${UV_COLORS[uvLevelIndex(weather.uv)]}`}>{weather.uv} · {wl.uvLevels[uvLevelIndex(weather.uv)]}</span></div>
                    <div class="weather-metric"><span class="weather-metric-label">{wl.sunrise}</span><span class="weather-metric-value">{todayWeather?.sunrise?.slice(11, 16) || '—'}</span></div>
                    <div class="weather-metric"><span class="weather-metric-label">{wl.sunset}</span><span class="weather-metric-value">{todayWeather?.sunset?.slice(11, 16) || '—'}</span></div>
