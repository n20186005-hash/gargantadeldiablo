              <p class="review-text">{review.text}</p>
              <div class="review-source">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="#4285F4"></path>
                </svg>
                Google
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="reveal">
      <div style="background:#fff;border-radius:12px;padding:2.5rem;border:1px solid rgba(0,0,0,0.05);box-shadow:0 10px 30px rgba(0,0,0,0.03);">
        <h3 style="font-family:var(--font-display);font-size:1.4rem;font-weight:600;color:var(--color-deep);margin-bottom:1rem;text-align:center;">{t.reviews.nearbyTitle}</h3>
        <p style="text-align:center;color:var(--color-earth-soft);margin-bottom:2rem;" set:html={renderText(t.reviews.nearbyIntro)}></p>
        <div style="display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));">
          {
            t.reviews.nearbyItems.map((item: any) => (
              <div style="padding:1.5rem;background:rgba(0,0,0,0.02);border-radius:8px;">
                <h4 style="font-family:var(--font-display);font-size:1.1rem;font-weight:600;color:var(--color-deep);margin-bottom:0.5rem;">📍 {item.name}</h4>
                <p style="font-size:0.9rem;color:var(--color-earth-soft);line-height:1.5;" set:html={renderText(item.description)}></p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <div class="reveal">
      <div style="text-align:center;margin-top:3rem;">
        <a href={MAPS_URL} target="_blank" rel="noopener noreferrer" class="google-maps-btn">
          {t.reviews.viewMore}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17L17 7M17 7H7M17 7V17"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="section">
      <div class="reveal">
        <p class="section-label">10</p>
        <h2 class="section-title">{t.faq.title}</h2>
        <p class="section-subtitle">{t.faq.subtitle}</p>
        <div class="section-divider"></div>
      </div>
      <div class="reveal">
        <div class="faq-list">
          {
            t.faq.items.map((item: any) => (
              <div class="faq-item">
                <button class="faq-question" data-faq type="button">
                  <span style="color:var(--color-deep);font-weight:600;">{item.question}</span>
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="faq-icon">
                    <path d="M6 9l6 6 6-6"></path>
                  </svg>
                </button>
                <div class="faq-answer">
                  {item.answer.split('\n\n').map((paragraph: string) => (
                    <p set:html={renderText(paragraph)}></p>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section id="location" class="section">
    <div class="reveal">
      <p class="section-label">11</p>
      <h2 class="section-title">{t.location.title}</h2>
      <div class="section-divider"></div>
    </div>
    <div class="reveal">
      <div class="location-section">
        <div class="location-map-container">
          <iframe
            src="https://www.google.com/maps?q=Garganta%20del%20Diablo%20Tilcara%20Jujuy%20Argentina&output=embed"
            width="800"
            height="600"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Garganta del Diablo Location Map"
          >
          </iframe>
        </div>
        <div class="location-info">
          <p class="location-address" style="white-space:pre-line;">{t.location.address}</p>
          <a href={MAPS_URL} target="_blank" rel="noopener noreferrer" class="maps-link">
            {t.location.openMaps}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Site Map -->
  <section id="sitemap" class="section">
    <div class="reveal">
      <p class="section-label">12</p>
      <h2 class="section-title">{t.siteMap.title}</h2>
      <p class="about-text" style="white-space:pre-line;margin-bottom:1rem;" set:html={renderText(t.siteMap.intro)}></p>
      <div class="sitemap-hint">{t.siteMap.hint}</div>
    </div>
    <div class="reveal">
      <div class="sitemap-wrap">
        <div class="sitemap-map" id="sitemap-map">
          <svg class="sitemap-svg" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <defs>
              <linearGradient id="hillGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#d9a86a" />
                <stop offset="100%" stop-color="#b56532" />
              </linearGradient>
            </defs>
            <path d="M0,300 L0,210 C60,180 90,150 150,160 C200,168 230,120 300,130 C350,137 380,110 400,120 L400,300 Z" fill="url(#hillGrad)" opacity="0.85" />
            <path d="M0,300 L0,240 C80,225 120,205 180,212 C250,220 300,200 400,210 L400,300 Z" fill="#a8531f" opacity="0.5" />
            <path d="M40,260 C120,235 200,250 280,225 C320,213 360,225 390,215" stroke="#faf7f2" stroke-width="2" fill="none" opacity="0.5" stroke-dasharray="4 6" />
            <path d="M70,150 C140,170 220,150 300,135" stroke="#faf7f2" stroke-width="1.5" fill="none" opacity="0.35" stroke-dasharray="3 7" />
          </svg>
          {
            t.siteMap.zones.map((z, i) => (
              <button class="sitemap-marker" type="button" data-zone={z.key}
                data-name={z.name} data-desc={z.desc}
                style={`top:${MARKER_POS[z.key].top};left:${MARKER_POS[z.key].left};`}>
                {i + 1}
              </button>
            ))
          }
        </div>
        <div class="sitemap-detail" id="sitemap-detail">
          <div class="sitemap-detail-index" id="sitemap-detail-index">01</div>
          <h3 class="sitemap-detail-name" id="sitemap-detail-name"></h3>
          <p class="sitemap-detail-desc" id="sitemap-detail-desc"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Itinerary -->
  <section id="itinerary" class="section" style="background:rgba(0,0,0,0.02);">
    <div class="reveal">
      <p class="section-label">13</p>
      <h2 class="section-title">{t.itinerary.title}</h2>
      <p class="about-text" style="white-space:pre-line;margin-bottom:3rem;" set:html={renderText(t.itinerary.intro)}></p>
    </div>
    <div class="reveal">
      <div class="timeline">
        {
          t.itinerary.steps.map((s) => (
            <div class="timeline-item">
              <div class="timeline-time">{s.time}</div>
              <div class="timeline-marker"><span class="timeline-dot"></span></div>
              <div class="timeline-card">
                <h4 class="timeline-title">{s.title}</h4>
                <p class="timeline-text">{s.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-links">
      <p class="footer-links-title">{t.footer.linksTitle}</p>
      <div class="footer-links-grid">
        {
          t.footer.links.map((link: any) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="footer-link-item">
              {link.name}
            </a>
          ))
        }
      </div>
      <div style="margin-top:1.25rem;text-align:center;">
        <a href={MAPS_URL} target="_blank" rel="noopener noreferrer" class="google-maps-btn">Google Maps →</a>
      </div>
    </div>
    <div class="footer-legal" style="max-width:1100px;margin:0 auto;padding:1rem 2rem 0;text-align:center;">
      <a href="/privacy" style="color:rgba(255,255,255,0.5);text-decoration:none;font-size:0.8rem;margin-right:1.5rem;">Privacy Policy</a>
      <a href="/terms" style="color:rgba(255,255,255,0.5);text-decoration:none;font-size:0.8rem;margin-right:1.5rem;">Terms of Service</a>
      <a href="/cookies" style="color:rgba(255,255,255,0.5);text-decoration:none;font-size:0.8rem;">Cookie Settings</a>
    </div>
    <p class="footer-text" style="margin-top:2rem;font-size:0.9rem;font-weight:600;color:var(--color-gold);">{t.footer.callToAction}</p>
    <p class="footer-text" style="margin-top:1rem;white-space:pre-line;">{t.footer.text}</p>
  </footer>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" style="display:none;">
    <button id="lightbox-close" class="lightbox-close" type="button">×</button>
    <button id="lightbox-prev" class="lightbox-prev" type="button">‹</button>
    <img id="lightbox-img" class="lightbox-img" src="" alt="" />
    <div id="lightbox-caption" class="lightbox-caption"></div>
    <button id="lightbox-next" class="lightbox-next" type="button">›</button>
  </div>
</BaseLayout>
